# BD Finance Android — API Keys
# Copy this file to .env and fill in your keys.
# All keys are optional — the app falls back to deterministic analysis without them.

# Groq (LLaMA 3.1 8B) — primary LLM for second-opinion commentary
GROQ_API_KEY=

# Google Gemini — LLM fallback when Groq is unavailable
GEMINI_API_KEY=

# Financial Modeling Prep — sector medians, 5Y/10Y fundamental history
FMP_API_KEY=

# Alpha Vantage — PEG, beta, sector fallback
ALPHA_VANTAGE_API_KEY=
