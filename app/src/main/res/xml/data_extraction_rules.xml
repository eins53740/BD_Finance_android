<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ cloud backup and device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up ticker watchlist stored in SharedPreferences -->
        <include domain="sharedpref" path="bd_finance_tickers.xml" />
        <!-- Exclude the Room database cache — it's rebuilt from network -->
        <exclude domain="database" path="stock_metrics.db" />
        <exclude domain="database" path="stock_metrics.db-wal" />
        <exclude domain="database" path="stock_metrics.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="bd_finance_tickers.xml" />
        <exclude domain="database" path="stock_metrics.db" />
        <exclude domain="database" path="stock_metrics.db-wal" />
        <exclude domain="database" path="stock_metrics.db-shm" />
    </device-transfer>
</data-extraction-rules>
